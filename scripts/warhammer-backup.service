[Unit]
Description=Warhammer DB backup to external drive
# Skip (not fail) the run if the backup drive isn't mounted.
ConditionPathIsMountPoint=/mnt/backup
After=warhammer.service

[Service]
Type=oneshot
User=christiangoff
WorkingDirectory=/home/christiangoff/warhammer
Environment=BACKUP_DIR=/mnt/backup/warhammer
Environment=BACKUP_RETAIN_DAYS=30
# /usr/local/bin/node is a stable symlink to whatever node is in use (see
# scripts/README.md); it survives nvm version switches, unlike ~/.nvm paths.
ExecStart=/usr/local/bin/node scripts/backup-db.mjs
